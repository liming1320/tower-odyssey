{
  "name": "tower-odyssey",
  "version": "1.0.0",
  "private": true,
  "description": "塔界远征 · 肉鸽推塔游戏（零依赖 Node + 原生前端，可选 MySQL 存储）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "pk32:rebuild": "node tools/build-pk32-reference.js",
    "pk32:inventory": "node tools/scan-pk32-inventory.js",
    "pk32:queue": "node tools/build-pk32-migration-queue.js",
    "pk32:verify-inventory": "node tools/verify-pk32-inventory.js",
    "migrate": "node tools/migrate-to-mysql.js",
    "seed:heroes": "node tools/gen-mysql-seed.js",
    "art": "node tools/gen-hero-art.js"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.0"
  }
}
