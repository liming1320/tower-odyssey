{
  "name": "tower-odyssey",
  "version": "1.0.0",
  "private": true,
  "description": "塔界远征 · 肉鸽推塔游戏（零依赖 Node + 原生前端，可选 MySQL 存储）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "pk32:rebuild": "node tools/build-pk32-reference.js",
    "pk32:inventory": "node tools/scan-pk32-inventory.js",
    "pk32:queue": "node tools/build-pk32-migration-queue.js",
    "pk32:extract-dimension-grids": "node tools/extract-pk32-dimension-grids.js",
    "pk32:structure-payloads": "node tools/build-pk32-structured-payloads.js",
    "pk32:resource-manifest": "node tools/build-pk32-resource-manifest.js",
    "pk32:native-ownership": "node tools/run-pk32-native-ownership.js",
    "pk32:migration-map": "node tools/build-pk32-native-migration-map.js",
    "pk32:migrate-all": "node tools/run-pk32-content-migration.js --skip-reference",
    "pk32:migrate-content": "node tools/run-pk32-content-migration.js",
    "pk32:runtime-export": "node tools/extract-pk32-minidump-vb5.js --write-image",
    "pk32:capture-full-memory": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/capture-pk32-full-memory.ps1 -Run",
    "pk32:capture-plan": "node tools/build-pk32-capture-plan.js",
    "pk32:capture-jobs": "node tools/export-pk32-capture-jobs.js",
    "pk32:scan-launcher": "powershell -ExecutionPolicy Bypass -File tools/scan-pk32-launcher.ps1",
    "pk32:mouse-batch": "powershell -ExecutionPolicy Bypass -File tools/capture-pk32-mouse-batch.ps1",
    "pk32:mouse-calibrate": "powershell -ExecutionPolicy Bypass -File tools/capture-pk32-mouse-batch.ps1 -Run -AllowDesktopInput -From 1 -To 4",
    "pk32:capture-dry-run": "npm run pk32:capture-plan && powershell -ExecutionPolicy Bypass -File tools/capture-pk32-batch.ps1",
    "pk32:decoded-docs": "node tools/build-pk32-decoded-docs.js",
    "pk32:verify-inventory": "node tools/verify-pk32-inventory.js",
    "pk32:verify-native-data": "node tools/verify-pk32-native-data.js",
    "pk32:verify-native-cdp": "node tools/verify-pk32-native-cdp.js",
    "pk32:validate": "node tools/run-pk32-validation.js --group=peg,native-extracted,same-color,pixel-island,jungle,sokoban4,light",
    "pk32:validate-all": "node tools/run-pk32-validation.js --all",
    "pk32:verify-sokoban4": "node tools/verify-pk32-sokoban4.js && node tools/verify-pk32-sokoban4-data.js && node tools/verify-pk32-sokoban4-cdp.js",
    "migrate": "node tools/migrate-to-mysql.js",
    "seed:heroes": "node tools/gen-mysql-seed.js",
    "art": "node tools/gen-hero-art.js"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.0"
  }
}
