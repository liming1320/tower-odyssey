# 依赖
node_modules/
dist/
output/pk32-reference/python-deps/

# 日志
*.log
npm-debug.log*

# 玩家存档（账号 / 进度 / 邮件，运行时数据）
# 绝不能进仓库：否则每次自动部署都会用本地测试存档覆盖线上真实玩家数据
data/db.json

# 自动备份（体积大且可随时重建，不同步）
game/data/backups/
data/backups/

# 模拟器 ROM 文件（管理员上传的二进制，仅存本机/服务器，不进仓库）
data/roms/
# 模拟器云存档同样是二进制且按用户分目录，只存运行态，不入库
data/emu-saves/

# 临时截图/测试产物（可选保留，默认不同步）
game/tools/shots/
game/tools/tmp/
tools/shots/
tools/tmp/

.tools/pe-tools/pe-tools-master
.playwright-cli
.codex

# PK32 反编译参考目录与浏览器测试产物（本地可重建/体积较大）
output/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 存档快照导出（默认不进仓库，避免多人覆盖）
data-export-*.json

# 已下线的旧立绘（来源为网络素材，存在版权风险，不再使用）
tools/_retired-hero-png/

# 数据库连接配置（含密码）
data/db-env.json

# ROM 中文名覆盖表（运行时数据：由 server/rom-zh-seed.json 自动生成、后台可在线编辑）
# 与 db.json 同理 —— 线上改过的翻译不该被本地版本覆盖
data/rom-zh.json

# AI 酒馆网关配置（含 SillyTavern 管理员口令）
data/tavern-env.json

# 部署日志
deploy/logs/
# Windows reserved-device-name junk file that blocks 'git add -A'
nul

# Python 缓存（测试/诊断脚本生成的字节码）
tools/__pycache__/
