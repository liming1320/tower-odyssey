# 依赖
node_modules/

# 日志
*.log
npm-debug.log*

# 玩家存档（账号 / 进度 / 邮件，运行时数据）
# 绝不能进仓库：否则每次自动部署都会用本地测试存档覆盖线上真实玩家数据
data/db.json

# 自动备份（体积大且可随时重建，不同步）
game/data/backups/
data/backups/

# 临时截图/测试产物（可选保留，默认不同步）
game/tools/shots/
game/tools/tmp/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 存档快照导出（默认不进仓库，避免多人覆盖）
data-export-*.json

# 已下线的旧立绘（来源为网络素材，存在版权风险，不再使用）
tools/_retired-hero-png/

# 部署日志
deploy/logs/
